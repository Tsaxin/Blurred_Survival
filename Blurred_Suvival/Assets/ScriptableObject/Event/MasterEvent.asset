    LootableObjects: []
    ShowChoiceButtonAtEndOfDialouge: 1
    DialougeChangeFrequency: 1
    PrimaryChoiceType: 0
    AllowRetreat: 1
    NPCLevel: 1
  - SurvivorCount: 2
    dialouge:
    - "Whoa! You\u2026 you\u2019re not one of them, right?"
    - "Uh\u2026 hey. Who\u2019s there? Don\u2019t sneak up on us."
    Icon: {fileID: 0}
    Survivors: []
    Vehicles: []
    LootableObjects: []
    ShowChoiceButtonAtEndOfDialouge: 1
    DialougeChangeFrequency: 1
    PrimaryChoiceType: 0
    AllowRetreat: 1
    NPCLevel: 1
  - SurvivorCount: 2
    dialouge:
    - "We lost Jenna last week. Thought she\u2019d be safe\u2026 she said she\u2019d
      scout ahead, never came back. I still hear her voice sometimes."
    - "I saw her shadow near the old pharmacy\u2026 my mind must be playing tricks."
    - "I don\u2019t know anymore. Every corner makes me think someone\u2019s gone
      forever\u2026 and then maybe not."
    - "Hey! Wait! Who\u2019s out there?"
    Icon: {fileID: 0}
    Survivors: []
    Vehicles: []
    LootableObjects: []
    ShowChoiceButtonAtEndOfDialouge: 1
    DialougeChangeFrequency: 1
    PrimaryChoiceType: 0
    AllowRetreat: 1
    NPCLevel: 1
  - SurvivorCount: 2
    dialouge:
    - "We can\u2019t trust anyone. Last week, that guy tried to steal our supplies."
    - "And what? Shoot him? We can\u2019t do that, not anymore. That\u2019s what
      made us human."
    - "Hey! Wait! Who\u2019s out there?"
    Icon: {fileID: 0}

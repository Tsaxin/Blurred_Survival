    PrimaryChoiceType: 0
    AllowRetreat: 1
    NPCLevel: 1
  - SurvivorCount: 2
    dialouge:
    - "I left my parents behind\u2026 thought I\u2019d be back in an hour. Never
      got there."
    - "I lost my dog on the first day\u2026 it\u2019s silly, but I still remember
      its bark."
    - "Nothing feels the same anymore. Everything\u2019s just\u2026 gone."
    - "Someone\u2019s there\u2026 who are you?"
    Icon: {fileID: 0}
    Survivors: []
    Vehicles: []
    LootableObjects: []
    ShowChoiceButtonAtEndOfDialouge: 1
    DialougeChangeFrequency: 1
    PrimaryChoiceType: 0
    AllowRetreat: 1
    NPCLevel: 1
  - SurvivorCount: 2
    dialouge:
    - "Remember when we thought a zombie was funny? Hah\u2026 not anymore."
    - "Nothing feels the same anymore. Everything\u2019s just\u2026 gone."
    Icon: {fileID: 0}
    Survivors: []

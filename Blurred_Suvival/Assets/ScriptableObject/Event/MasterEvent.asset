    AllowRetreat: 1
    NPCLevel: 1
  - SurvivorCount: 2
    dialouge:
    - "If we get past the river, there\u2019s a town with lights. Maybe people\u2026
      maybe not."
    - "Lights could mean safety\u2026 or a trap."
    - "Hey! You! Don\u2019t come closer!"
    Icon: {fileID: 0}

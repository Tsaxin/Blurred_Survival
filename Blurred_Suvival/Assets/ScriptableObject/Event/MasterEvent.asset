  - SurvivorCount: 2
    dialouge:
    - "I heard there\u2019s a safe zone east\u2026 no walkers."
    - "Hey! Wait! Who\u2019s out there?"
    Icon: {fileID: 0}
    Survivors:
    - {fileID: 3816641826279779961, guid: 71d2c79699aa9964a9969210235f8fd1, type: 3}
